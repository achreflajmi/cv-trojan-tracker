# Copy to .env (git-ignored) and fill in. Never commit .env.

# Local infrastructure (docker compose reads these too)
POSTGRES_USER=ctt
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ctt
DATABASE_URL=postgres://ctt:change-me-locally@localhost:5432/ctt
REDIS_URL=redis://localhost:6379

# Model provider keys: not needed until Stage 1 (Anthropic) and Stage 4 (the rest)
ANTHROPIC_API_KEY=
# Only needed if the key is not scoped to a workspace (Console > Settings > Workspaces).
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
